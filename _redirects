# Fixfly Innovations Netlify Proxy & Routing Rules

# 1. Static API endpoints (matches vercel.json and server.js)
/api/services           /data/services.json           200
/api/software           /data/software_products.json  200
/api/rates              /data/rates.json              200
/api/experts            /data/experts.json            200
/api/amazon-products    /data/amazon_products.json    200
/api/google-reviews     /data/google_reviews.json     200
/api/software-reviews   /data/software_reviews.json   200
/api/all-reviews        /data/service_reviews.json    200
/api/service-reviews    /data/service_reviews.json    200
/api/orders             /data/orders.json             200
/api/blogs              /data/custom_blogs.json       200
/api/deleted-blogs      /data/deleted_blogs.json      200

# 2. Assets & Direct routes
/assets/*               /public/assets/:splat         200
/admin                  /admin.html                   200
/admin/*                /admin.html                   200
/download               /download.html                200
/download-zip           /fixfly-netlify-ready.zip     200

# 3. Client-side SPA fallback (served only when no pre-rendered static route HTML file exists)
/*                      /index.html                   200
